import { useState } from 'react'
import type { Product } from '../../preload/index.d'

interface CartItem {
  product: Product
  quantity: number
}

interface CartProps {
  items: CartItem[]
  onUpdateQuantity: (productId: number, delta: number) => void
  onRemove: (productId: number) => void
